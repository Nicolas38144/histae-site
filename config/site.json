{
  "publicUrl": "https://www.histae.com",
  "defaultLocale": "fr",
  "repositories": {
    "api": "https://github.com/Nicolas38144/histae-api-rust",
    "app": "https://github.com/Nicolas38144/histae-app",
    "site": "https://github.com/Nicolas38144/histae-site"
  },
  "locales": {
    "fr": {
      "label": "Français",
      "openGraph": "fr_FR"
    },
    "en": {
      "label": "English",
      "openGraph": "en_GB"
    },
    "es": {
      "label": "Español",
      "openGraph": "es_ES"
    },
    "it": {
      "label": "Italiano",
      "openGraph": "it_IT"
    }
  },
  "routes": {
    "home": {
      "path": "",
      "navigation": true,
      "priority": 1
    },
    "feature": {
      "path": "feature",
      "navigation": true,
      "priority": 0.8
    },
    "pricing": {
      "path": "pricing",
      "navigation": true,
      "priority": 0.8
    },
    "safety": {
      "path": "security",
      "navigation": true,
      "priority": 0.8
    },
    "faq": {
      "path": "faq",
      "navigation": false,
      "priority": 0.8
    },
    "about": {
      "path": "about",
      "navigation": true,
      "priority": 0.8
    },
    "download": {
      "path": "download",
      "navigation": false,
      "priority": 0.8
    }
  },
  "billingReturns": {
    "success": {
      "path": "billing/success"
    },
    "cancel": {
      "path": "billing/cancel"
    },
    "return": {
      "path": "billing/return"
    }
  },
  "legalDocuments": {
    "terms-of-use": {
      "source": "conditions-utilisation"
    },
    "privacy-policy": {
      "source": "politique-confidentialite"
    },
    "sensitive-data-consent": {
      "source": "consentement-donnees-sensibles"
    },
    "location-consent": {
      "source": "consentement-localisation"
    }
  },
  "plans": {
    "free": {
      "priceCents": 0,
      "successfulContinuationsPerWeek": 6,
      "featured": false,
      "features": [
        "messaging",
        "photoReveal",
        "limitedContinuations",
        "rewardedCredits",
        "weeklyLimit"
      ],
      "weeklyIncludedCredits": 3,
      "advertisingCreditStockLimit": 3
    },
    "premium": {
      "featured": true,
      "features": [
        "messaging",
        "photoReveal",
        "unlimitedContinuations",
        "noAds"
      ]
    }
  }
}
